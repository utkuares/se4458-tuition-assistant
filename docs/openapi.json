{
  "openapi": "3.1.0",
  "info": {
    "title": "Tuition API",
    "description": "University tuition REST API.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Log in with username and password, receive a JWT access token.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "Return the identity of the caller, taken from the Bearer token.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Me Api V1 Auth Me Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/banking/tuition/{student_no}": {
      "get": {
        "tags": [
          "tuition"
        ],
        "summary": "Banking Query Tuition",
        "description": "Query tuition and balance. Bank: any student. Student: only their own number.",
        "operationId": "banking_query_tuition_api_v1_banking_tuition__student_no__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "student_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$",
              "examples": [
                "20230001"
              ],
              "title": "Student No"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mobile/tuition/{student_no}": {
      "get": {
        "tags": [
          "tuition"
        ],
        "summary": "Mobile Query Tuition",
        "description": "Query tuition without login. Limited to 3 queries per student number per day.",
        "operationId": "mobile_query_tuition_api_v1_mobile_tuition__student_no__get",
        "parameters": [
          {
            "name": "student_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$",
              "examples": [
                "20230001"
              ],
              "title": "Student No"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/banking/payments": {
      "post": {
        "tags": [
          "payments"
        ],
        "summary": "Pay Tuition",
        "description": "Pays tuition. Banks can pay for anyone, students only for themselves.",
        "operationId": "pay_tuition_api_v1_banking_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Add Tuition",
        "description": "Adds a tuition record (201). If the student already has one for that term, updates it (200).",
        "operationId": "add_tuition_api_v1_admin_tuition_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTuitionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition/batch": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Add Tuition Batch",
        "description": "Adds or updates many tuition records from a CSV file and reports failed rows.",
        "operationId": "add_tuition_batch_api_v1_admin_tuition_batch_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_add_tuition_batch_api_v1_admin_tuition_batch_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition/unpaid": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Unpaid Tuition Status",
        "description": "Lists students who still owe money for the given term (paged).",
        "operationId": "unpaid_tuition_status_api_v1_admin_tuition_unpaid_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnpaidPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddTuitionRequest": {
        "properties": {
          "student_no": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "title": "Student No",
            "examples": [
              "20230002"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
            "title": "Term",
            "examples": [
              "2027-SPRING"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "3000.00"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "USD",
            "examples": [
              "USD"
            ]
          }
        },
        "type": "object",
        "required": [
          "student_no",
          "term",
          "amount"
        ],
        "title": "AddTuitionRequest"
      },
      "BatchFailure": {
        "properties": {
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "student_no": {
            "type": "string",
            "title": "Student No"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "line",
          "student_no",
          "reason"
        ],
        "title": "BatchFailure"
      },
      "BatchResult": {
        "properties": {
          "total_rows": {
            "type": "integer",
            "title": "Total Rows"
          },
          "success_count": {
            "type": "integer",
            "title": "Success Count"
          },
          "failure_count": {
            "type": "integer",
            "title": "Failure Count"
          },
          "failures": {
            "items": {
              "$ref": "#/components/schemas/BatchFailure"
            },
            "type": "array",
            "title": "Failures"
          }
        },
        "type": "object",
        "required": [
          "total_rows",
          "success_count",
          "failure_count",
          "failures"
        ],
        "title": "BatchResult"
      },
      "Body_add_tuition_batch_api_v1_admin_tuition_batch_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "CSV with header: studentNo,term,amount,currency"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_add_tuition_batch_api_v1_admin_tuition_batch_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Username",
            "examples": [
              "student1"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "examples": [
              "Passw0rd!"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PaymentRequest": {
        "properties": {
          "student_no": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "title": "Student No",
            "examples": [
              "20230001"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
            "title": "Term",
            "examples": [
              "2026-FALL"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "500.00"
            ]
          },
          "transaction_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Transaction Id",
            "examples": [
              "TX-0001"
            ]
          }
        },
        "type": "object",
        "required": [
          "student_no",
          "term",
          "amount",
          "transaction_id"
        ],
        "title": "PaymentRequest"
      },
      "PaymentResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "student_no": {
            "type": "string",
            "title": "Student No"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "paid_amount": {
            "type": "string",
            "title": "Paid Amount"
          },
          "remaining_balance": {
            "type": "string",
            "title": "Remaining Balance"
          }
        },
        "type": "object",
        "required": [
          "status",
          "transaction_id",
          "student_no",
          "term",
          "amount",
          "currency",
          "paid_amount",
          "remaining_balance"
        ],
        "title": "PaymentResponse"
      },
      "TermBalance": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "tuition": {
            "type": "string",
            "title": "Tuition"
          },
          "paid": {
            "type": "string",
            "title": "Paid"
          },
          "balance": {
            "type": "string",
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "term",
          "currency",
          "tuition",
          "paid",
          "balance"
        ],
        "title": "TermBalance"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "role"
        ],
        "title": "TokenResponse"
      },
      "TuitionRecord": {
        "properties": {
          "student_no": {
            "type": "string",
            "title": "Student No"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "paid_amount": {
            "type": "string",
            "title": "Paid Amount"
          },
          "balance": {
            "type": "string",
            "title": "Balance"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "student_no",
          "term",
          "currency",
          "amount",
          "paid_amount",
          "balance",
          "created"
        ],
        "title": "TuitionRecord"
      },
      "TuitionSummary": {
        "properties": {
          "student_no": {
            "type": "string",
            "title": "Student No"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "total_tuition": {
            "type": "string",
            "title": "Total Tuition"
          },
          "total_paid": {
            "type": "string",
            "title": "Total Paid"
          },
          "balance": {
            "type": "string",
            "title": "Balance"
          },
          "terms": {
            "items": {
              "$ref": "#/components/schemas/TermBalance"
            },
            "type": "array",
            "title": "Terms"
          }
        },
        "type": "object",
        "required": [
          "student_no",
          "scope",
          "total_tuition",
          "total_paid",
          "balance",
          "terms"
        ],
        "title": "TuitionSummary"
      },
      "UnpaidItem": {
        "properties": {
          "student_no": {
            "type": "string",
            "title": "Student No"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "tuition": {
            "type": "string",
            "title": "Tuition"
          },
          "paid": {
            "type": "string",
            "title": "Paid"
          },
          "balance": {
            "type": "string",
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "student_no",
          "full_name",
          "currency",
          "tuition",
          "paid",
          "balance"
        ],
        "title": "UnpaidItem"
      },
      "UnpaidPage": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_items": {
            "type": "integer",
            "title": "Total Items"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/UnpaidItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "term",
          "page",
          "page_size",
          "total_items",
          "total_pages",
          "items"
        ],
        "title": "UnpaidPage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
